{
	"name": "gudenaa",
	"version": "1.1.0",
	"description": "Cypress project to extract link",
	"repository": "https://github.com/NY-Daystar/Gudenaa",
	"author": "Lucas Noga <luc4snoga@gmail.com>",
	"bugs": {
		"url": "https://github.com/NY-Daystar/Gudenaa/issues"
	},
	"homepage": "https://github.com/NY-Daystar/Gudenaa#readme",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=24.0.0"
	},
	"type": "module",
	"main": "index.js",
	"scripts": {
		"start": "npx cypress open",
		"spec": "cypress run --spec 'cypress/e2e/$npm_config_file.cy.js'",
		"spec:win": "cypress run --spec 'cypress/e2e/%npm_config_file%.cy.js'",
		"get-links": "cypress run --spec 'cypress/e2e/get-links.cy.js'",
		"yt-playlist": "node cypress/e2e/yt-playlist.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prettier": "prettier --check **/*.js",
		"prettier:fix": "prettier --write **/*.js"
	},
	"keywords": [
		"cypress"
	],
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.6.1",
		"@stylistic/eslint-plugin-js": "^4.4.1",
		"axios": "^1.13.2",
		"cypress": "^15.7.1",
		"eslint": "^9.39.2",
		"prettier": "^3.7.4"
	}
}
